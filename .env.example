# Required. At least 10 characters.
ADMIN_PASSWORD=

# The name your customers see.
BUSINESS_NAME=My Business

# Public address of this server, without a trailing slash.
BASE_URL=http://127.0.0.1:3000

# Optional.
BRAND_COLOR=#141216
ACCENT_COLOR=#f6a823
STAMPS=10
LANGUAGE=en
CONTACT_EMAIL=

# Leave empty if a full card earns nothing and simply starts again.
REWARD=

# Set to 1 only behind a reverse proxy.
TRUST_PROXY=0

# Optional: Google Wallet. See the README.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CLASS=theusual
# Only if the app itself isn't public: a public HTTPS address that serves /wallet/stamps/.
GOOGLE_WALLET_IMAGES_URL=
